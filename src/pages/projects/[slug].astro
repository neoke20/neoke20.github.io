---
import "../../styles/global.css";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&family=VT323&display=swap"
      rel="stylesheet"
    />
    <title>{project.data.name} - Kevin Konczak</title>
  </head>
  <body class="bg-primary">
    <div class="px-6 py-10 mb-20">
      <a href="/" class="text-text text-xl font-outfit-600">
        <div class="flex justify-center items-center gap-4">
          <Icon name="arrow-left" class="text-xl" />
          <h1 class="text-center text-text text-xl font-outfit-600 uppercase">{project.data.name}</h1>
        </div>
      </a>
      <div class="lg:flex lg:gap-12 lg:justify-center lg:mt-20">
        {
          project.data.image && (
            <Image
              src={project.data.image}
              alt={project.data.name}
              class="w-full h-auto rounded-lg my-6 lg:w-1/2 lg:max-w-[700px] lg:my-0 lg:shrink-0"
            />
          )
        }
        <div class="prose prose-invert">
          <Content />
        </div>
      </div>
    </div>
  </body>
</html>
